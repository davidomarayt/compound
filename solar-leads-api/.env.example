# Dedicated Compound-owned Supabase project ONLY; do not use MyClinician or PlotMap
SUPABASE_URL=https://YOUR_COMPOUND_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REPLACE_IN_VERCEL_SECRETS_ONLY
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Stripe: configure/test with test mode first, never publish secret keys
STRIPE_SECRET_KEY=sk_test_REPLACE_IN_VERCEL_SECRETS_ONLY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_IN_VERCEL_SECRETS_ONLY

# Verified sender and spam protection (required for homeowner quote intake)
RESEND_API_KEY=re_REPLACE_IN_VERCEL_SECRETS_ONLY
MAIL_FROM=Compound Solar <noreply@compound.ie>
TURNSTILE_SECRET=REPLACE_IN_VERCEL_SECRETS_ONLY
PUBLIC_API_URL=https://YOUR-API-SUBDOMAIN.example.ie

# Both feature flags default OFF. Only enable after tested end-to-end checks.
SOLAR_LEADS_INTAKE_ENABLED=false
SOLAR_LEADS_PAYMENTS_ENABLED=false
# Never true during test mode; separate approval required for any live Stripe charge.
SOLAR_LEADS_REAL_CHARGES_APPROVED=false
ADMIN_API_TOKEN=REPLACE_WITH_32_PLUS_BYTE_RANDOM_STRING
