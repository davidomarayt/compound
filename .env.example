# --- Telegram -------------------------------------------------------------
# Token from @BotFather. Keep this bot separate from any other project's bot.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id. The bot ignores everyone else.
# Leave blank on first run, send /start to the bot, and it will tell you the id.
TELEGRAM_OWNER_ID=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Speech to text -------------------------------------------------------
# openai  -> any OpenAI-compatible /v1/audio/transcriptions endpoint (OpenAI, Groq, ...)
# none    -> voice notes are rejected and you are asked to type instead
STT_PROVIDER=none
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Site -----------------------------------------------------------------
# Public URL of the built site and of the preview pages (usually the same host).
SITE_BASE_URL=http://localhost:8080
PREVIEW_BASE_URL=http://localhost:8080
# Email form action URL (Kit / MailerLite embed endpoint). Blank = form posts nowhere yet.
EMAIL_FORM_ACTION=
# Optional shell command run after every publish (e.g. rsync public/ to a host). Blank = none.
DEPLOY_COMMAND=

# --- Pipeline -------------------------------------------------------------
POLL_INTERVAL_MINUTES=30
# On the very first poll of a source, how many of the newest existing items to process
# (the rest are marked seen so the bot does not send you a year of back-catalogue).
FIRST_RUN_BACKFILL=1
# 1 = the bot asks you a few questions per item before drafting (your take goes into the piece).
# 0 = no questions; every new item is drafted straight from the source and sent for review.
INTERVIEW=1
# Set to 1 to use canned LLM output instead of calling Anthropic (for testing the loop).
COMPOUND_FAKE_LLM=0
