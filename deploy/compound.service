# /etc/systemd/system/compound.service
[Unit]
Description=Compound.ie pipeline (Telegram bot + source poller)
After=network-online.target
Wants=network-online.target

[Service]
User=compound
WorkingDirectory=/srv/compound
# HOME so Claude Code finds its login under ~/.claude; PATH so `claude` resolves if CLAUDE_CODE_BIN is unset.
Environment=HOME=/srv/compound
Environment=PATH=/srv/compound/.local/bin:/srv/compound/.venv/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/srv/compound/.env
ExecStart=/srv/compound/.venv/bin/compound run
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
