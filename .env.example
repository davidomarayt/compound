# --- Telegram -------------------------------------------------------------
# Token from @BotFather. Keep this bot separate from any other project's bot.
TELEGRAM_BOT_TOKEN=
# Your own Telegram user id. The bot ignores everyone else.
# Leave blank on first run, send /start to the bot, and it will tell you the id.
TELEGRAM_OWNER_ID=

# --- Which Claude to use --------------------------------------------------
# api         -> the Anthropic API with ANTHROPIC_API_KEY below (pay per token)
# claude-code -> run the Claude Code CLI installed on this machine in headless mode; it uses whatever
#                `claude` is logged in as, so a Pro/Max subscription covers it. No API key needed.
LLM_BACKEND=api
CLAUDE_CODE_BIN=claude
# Model for the claude-code backend: blank = Claude Code's default; or opus / sonnet / a full model id.
CLAUDE_CODE_MODEL=

# --- Anthropic ------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Thinking effort for article drafts: high (best), medium (about half the cost), low.
DRAFT_EFFORT=high

# --- Speech to text -------------------------------------------------------
# openai  -> any OpenAI-compatible /v1/audio/transcriptions endpoint (OpenAI, Groq, ...)
# none    -> voice notes are rejected and you are asked to type instead
STT_PROVIDER=none
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Site -----------------------------------------------------------------
# Public URL of the built site and of the preview pages (usually the same host).
SITE_BASE_URL=http://localhost:8080
PREVIEW_BASE_URL=http://localhost:8080
# Email form action URL (Kit / MailerLite embed endpoint). Blank = form posts nowhere yet.
EMAIL_FORM_ACTION=
# Optional shell command run after every publish (e.g. rsync public/ to a host). Blank = none.
DEPLOY_COMMAND=

# --- Pipeline -------------------------------------------------------------
POLL_INTERVAL_MINUTES=30
# On the very first poll of a source, how many of the newest existing items to process
# (the rest are marked seen so the bot does not send you a year of back-catalogue).
FIRST_RUN_BACKFILL=1
# 1 = the bot asks you a few questions per item before drafting (your take goes into the piece).
# 0 = no questions; every new item is drafted straight from the source and sent for review.
INTERVIEW=1
# Before drafting, Claude scores each polled item 0-10 for relevance to an everyday reader in Ireland.
# Items below this score are skipped with a one-line note (/open <id> drafts them anyway). 0 = draft everything.
MIN_RELEVANCE=6

# --- Scheduled writing ------------------------------------------------------
# Write one evergreen piece every N hours while the bot runs, rotating through SCHEDULE_PILLARS.
# Topics come from topics/<pillar>.md if present, else Claude proposes one. 0 = off.
SCHEDULE_HOURS=0
SCHEDULE_PILLARS=health,wealth,happiness
# off      -> every scheduled draft waits for your ✅ in Telegram (default)
# verified -> publish automatically only when every figure checks out against its source and
#             nothing else is flagged; anything with a warning is held for your tap
# always   -> publish everything automatically (no figure check; not recommended)
AUTO_PUBLISH=off
# Set to 1 to use canned LLM output instead of calling Anthropic (for testing the loop).
COMPOUND_FAKE_LLM=0
