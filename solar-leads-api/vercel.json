{
  "version": 2,
  "functions": {"api/*.js": {"maxDuration": 15}},
  "headers": [
    {"source": "/api/(.*)", "headers": [
      {"key":"Cache-Control","value":"no-store, max-age=0"},
      {"key":"Referrer-Policy","value":"no-referrer"},
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Robots-Tag","value":"noindex"}
    ]}
  ]
}
