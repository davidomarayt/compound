{
  "ci": {
    "collect": {
      "url": [
        "https://compound.ie/",
        "https://compound.ie/news/",
        "https://compound.ie/wealth/how-to-start-investing-in-ireland/",
        "https://compound.ie/wealth/pensions-in-ireland/",
        "https://compound.ie/wealth/buying-a-home-in-ireland/",
        "https://compound.ie/mortgage-calculator/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "maxWaitForLoad": 15000
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.95
          }
        ],
        "largest-contentful-paint": [
          "error",
          {
            "maxNumericValue": 4000
          }
        ],
        "cumulative-layout-shift": [
          "error",
          {
            "maxNumericValue": 0.1
          }
        ],
        "total-blocking-time": [
          "error",
          {
            "maxNumericValue": 350
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci-live"
    }
  }
}
